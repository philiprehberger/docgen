APP_NAME=Docgen
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses sqlite + sync queue. Production uses MySQL + Redis.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=docgen
# DB_USERNAME=docgen
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Local: sync (jobs run inline). Production: redis (Horizon).
QUEUE_CONNECTION=sync
# QUEUE_CONNECTION=redis

CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Rendered-output storage path (relative to storage/app).
DOCGEN_RENDERED_PATH=rendered
DOCGEN_ASSETS_PATH=assets

# Default signed-URL TTL for rendered output downloads (seconds).
DOCGEN_DEFAULT_SIGNED_URL_TTL=3600
DOCGEN_MAX_SIGNED_URL_TTL=86400

# Hard caps on input shapes.
DOCGEN_TEMPLATE_BODY_MAX_BYTES=262144
DOCGEN_INPUT_DATA_MAX_BYTES=1048576

# Sync render mode timeout (seconds) before falling back to async 202.
DOCGEN_SYNC_RENDER_TIMEOUT=15

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@docgen.philiprehberger.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
